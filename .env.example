# ─── Database (Neon, Supabase, or any Postgres) ───────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/rentingi?sslmode=require"

# ─── Redis (Redis Cloud, Upstash, Railway Redis) ──────────────────────────────
# For TLS: rediss://default:PASSWORD@host:port
REDIS_URL="redis://localhost:6379"

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Production cutover (required for live renting.rw):
# 1. Use live keys (pk_live_ / sk_live_), not pk_test_ / sk_test_.
#    Live keys remove Clerk's "Development mode" badge.
# 2. In Clerk Dashboard → Webhooks, create an endpoint:
#      POST https://api.renting.rw/webhooks/clerk
#    Subscribe to user.created and user.updated.
# 3. Paste the signing secret below as CLERK_WEBHOOK_SECRET (whsec_...).
# Local API: POST http://localhost:3001/webhooks/clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxx"
CLERK_SECRET_KEY="sk_live_xxx"
CLERK_WEBHOOK_SECRET="whsec_xxx"

# ─── iPay / MoPay (payments) ──────────────────────────────────────────────────
IPAY_API_KEY="your-ipay-api-key"

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─── Africa's Talking (SMS) ───────────────────────────────────────────────────
AT_API_KEY="your-africas-talking-api-key"
AT_USERNAME="your-at-username"

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="renting.rw <noreply@renting.rw>"

# ─── Flutterwave (payments) ───────────────────────────────────────────────────
FLW_PUBLIC_KEY="FLWPUBK-xxx"
FLW_SECRET_KEY="FLWSECK-xxx"
FLW_WEBHOOK_SECRET="your-flutterwave-webhook-secret"

# ─── MTN MoMo ─────────────────────────────────────────────────────────────────
MTN_MOMO_BASE_URL="https://proxy.momoapi.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY="your-mtn-subscription-key"
MTN_MOMO_API_USER="your-mtn-api-user"
MTN_MOMO_API_KEY="your-mtn-api-key"
MTN_MOMO_WEBHOOK_SECRET="your-mtn-webhook-secret"

# ─── Airtel Money ─────────────────────────────────────────────────────────────
AIRTEL_BASE_URL="https://openapi.airtel.africa"
AIRTEL_CLIENT_ID="your-airtel-client-id"
AIRTEL_CLIENT_SECRET="your-airtel-client-secret"
AIRTEL_WEBHOOK_SECRET="your-airtel-webhook-secret"

# ─── Admin portal (email/password JWT, not Clerk) ─────────────────────────────
ADMIN_USERNAME="admin@renting.rw"
ADMIN_PASSWORD="change-me"
ADMIN_JWT_SECRET="change-me-to-a-long-random-string"

# ─── Public URLs (set these in Vercel / Railway env vars for production) ──────
# Production values:
#   NEXT_PUBLIC_APP_URL=https://renting.rw
#   NEXT_PUBLIC_ADMIN_URL=https://admin.renting.rw
#   NEXT_PUBLIC_API_URL=https://api.renting.rw
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
NEXT_PUBLIC_API_URL="http://localhost:3001"
